{
  "name": "dsh-goal-queue",
  "version": "0.2.0",
  "private": true,
  "description": "Native cross-workspace serial goal queue for DeepSeek Harness Desktop v0.2.1-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-settings-controller"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-api-workspace-controller": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-store": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.2.2",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-api-settings-controller": ">=0.2.1-rc.2 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.2 <0.2.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2"
  }
}
