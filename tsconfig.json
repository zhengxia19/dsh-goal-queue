{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "noEmit": true, "strict": true,
    "skipLibCheck": true, "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true, "esModuleInterop": true,
    "types": ["node", "react"]
  },
  "include": ["src/**/*", "test/**/*", "tsdown.config.ts"]
}
